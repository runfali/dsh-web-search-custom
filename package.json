{
  "name": "dsh-web-search-custom",
  "version": "0.3.0",
  "description": "Search provider for the DeepSeek Harness web profile (ctx.web): defaults to the AnySearch unified API (anonymous free tier works with no API key; add a key for the paid quota), and still speaks any SearXNG-compatible JSON endpoint. Includes an in-settings configuration card. Zero-intrusion bundle plugin.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "tests",
    "cordis.patch.yml",
    "docs/DSH-0.1.7-ADAPTATION.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs && node tests/client-smoke.mjs",
    "test:host": "node --test tests/host-integration.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "anysearch",
    "searxng",
    "search-engine"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.2-alpha.3 <0.1.8 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-alpha.0 <0.1.8 || >=0.2.0-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.3 <0.1.8 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-alpha.0 <0.1.8 || >=0.2.0-alpha.0 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": "^18.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-alpha.3 <0.1.8 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.7-alpha.0 <0.1.8 || >=0.2.0-alpha.0 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runfali/dsh-web-search-custom.git"
  }
}